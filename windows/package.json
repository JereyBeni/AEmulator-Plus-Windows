{
  "name": "aemulator-plus-windows",
  "version": "0.1.0",
  "description": "AEmulator Plus para Windows: interfaz Material You y biblioteca de firmwares Android 2.3-3.0",
  "main": "dist/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "electron": "31.7.7",
    "electron-builder": "24.13.3",
    "typescript": "5.5.4",
    "vite": "5.4.2"
  },
  "build": {
    "appId": "io.github.jereybeni.aemulator-plus",
    "productName": "AEmulator Plus",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "publish": null
  },
  "author": "JereyBeni",
  "repository": "https://github.com/JereyBeni/AEmulator-Plus-Windows"
}
